+  display: grid;
+  grid-template-columns: 230px minmax(0, 1fr);
+  min-height: 100dvh;
+  color: var(--adm-ink);
+  background: var(--adm-bg);
+  font-size: .875rem;
+}
+
+.adm-shell :focus-visible { outline: 2px solid var(--adm-accent); outline-offset: 2px; }
+.adm-shell button:disabled { cursor: not-allowed; opacity: .57; }
