+.adm-table td { color: #46516b; }
+.adm-table tbody th { font-weight: 550; }
+.adm-table tbody th strong, .adm-table tbody th small { display: block; overflow-wrap: anywhere; }
+.adm-table tbody th small { font-size: .73rem; margin-top: 2px; font-weight: 400; color: var(--adm-muted); max-width: 340px; }
+.adm-table tbody th small:empty { display: none; }
+.adm-actions { text-align: right; }
+.adm-status {
+  display: inline-flex;
+  width: fit-content;
+  align-items: center;
+  gap: 5px;
+  border-radius: 20px;
+  padding: 4px 8px;
+  white-space: nowrap;
+  font-weight: 650;
+  font-size: .7rem;
+  line-height: 1.2;
+  color: #485469;
+  background: #edf0f6;
+}
+.adm-status::before { content: ''; inline-size: 5px; block-size: 5px; border-radius: 50%; background: currentColor; }
+.adm-status[data-mau=xanh] { color: #126356; background: #e1f5ed; }
+.adm-status[data-mau=vang] { color: #805018; background: #fff0d6; }
+.adm-status[data-mau=do] { color: #9c323b; background: #ffeaed; }
+.adm-status[data-mau=vam] { color: #4338a6; background: #edebfc; }
+.adm-btn {
+  display: inline-flex;
+  justify-content: center;
+  align-items: center;
+  gap: 6px;
+  width: fit-content;
+  border-radius: 8px;
+  min-height: 37px;
+  padding: 7px 11px;
+  font-size: .82rem;
+  font-weight: 650;
+  white-space: nowrap;
+  border: 1px solid transparent;
+}
+.adm-primary { color: #fff; background: var(--adm-accent); }
+.adm-primary:enabled:hover { background: var(--adm-accent-dark); }
+.adm-secondary { color: var(--adm-ink); border-color: var(--adm-line); background: #fff; }
+.adm-edit { color: var(--adm-accent-dark); min-height: 32px; padding: 5px 8px; }
+.adm-secondary:enabled:hover, .adm-edit:enabled:hover { background: var(--adm-soft); }
+.adm-danger-text { color: #9c323b; }
+.adm-empty { margin: 0; padding: 28px 16px; text-align: center; color: var(--adm-muted); }
+.adm-feedback { margin: 0; padding: 9px 12px; border-radius: 8px; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; border: 1px solid transparent; }
+.adm-feedback button { font-weight: 650; text-decoration: underline; }
+.adm-error { color: #8f2731; background: #fff0f0; border-color: #f7d6d7; }
+.adm-success { color: #135c4b; background: #e8f7f0; border-color: #cfeadd; }
+
+.adm-drawer {
+  position: fixed;
+  inset: 0 0 0 auto;
+  margin: 0;
+  height: 100dvh;
+  max-height: 100dvh;
+  max-width: 100%;
+  width: min(100%, 520px);
+  color: var(--adm-ink);
+  background: #fff;
+  box-shadow: -12px 0 50px #21223428;
+}
+.adm-drawer::backdrop { background: #18213a69; }
+.adm-drawer[open] { display: flex; flex-direction: column; }
+.adm-drawer > header { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 17px 21px; border-bottom: 1px solid var(--adm-line); }
+.adm-drawer h2 { font-size: 1.17rem; font-weight: 720; letter-spacing: -.025em; }
+.adm-drawer header p { color: var(--adm-muted); margin-top: 4px; overflow-wrap: anywhere; }
+.adm-drawer-body { padding: 19px 21px; display: grid; align-content: start; gap: 17px; overflow: auto; }
+.adm-form { display: grid; gap: 15px; }
+.adm-form-grid { display: grid; gap: 13px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
+.adm-field { display: grid; gap: 5px; min-width: 0; font-size: .8rem; font-weight: 630; }
+.adm-field-wide { grid-column: 1 / -1; }
+.adm-form-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 7px; }
+.adm-subform { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 8px; border-top: 1px solid var(--adm-line); padding-top: 15px; }
+.adm-segments { display: inline-flex; flex-wrap: wrap; gap: 2px; padding: 3px; border-radius: 8px; background: #f0f1f8; }
+.adm-segments button { padding: 6px 8px; border-radius: 6px; font-size: .78rem; color: var(--adm-muted); }
+.adm-segments button[aria-pressed=true] { color: var(--adm-accent-dark); font-weight: 700; background: #fff; box-shadow: 0 1px 3px #1c275215; }
+.adm-segments span { margin-inline-start: 3px; }
+.adm-assign-list > li { display: grid; grid-template-columns: minmax(145px, 1fr) minmax(105px, .55fr) minmax(170px, 1.45fr); gap: 10px; align-items: center; border-top: 1px solid var(--adm-line); padding: 12px 16px; }
+.adm-assignee { display: flex; align-items: center; gap: 8px; min-width: 0; }
+.adm-assignee small, .adm-current small { display: block; color: var(--adm-muted); margin-top: 4px; font-size: .75rem; }
+.adm-assignee small.adm-warning { color: #8a4f16; }
+.adm-assign-form { display: flex; gap: 6px; flex-wrap: wrap; }
+.adm-assign-form select { flex: 1 1 145px; min-width: 130px; }
+
+@media (max-width: 1000px) {
+  .adm-stat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+@media (max-width: 850px) {
+  .adm-shell { grid-template-columns: 190px minmax(0, 1fr); }
+  .adm-assign-list > li { grid-template-columns: minmax(0, 1fr) auto; }
+  .adm-assign-form { grid-column: 1 / -1; }
+}
+@media (max-width: 680px) {
+  .adm-shell { display: block; }
+  .adm-sidebar { position: static; height: auto; border-right: 0; }
+  .adm-brand { padding: 12px 16px; }
+  .adm-menu-toggle { display: inline-grid; }
+  .adm-nav { display: none; gap: 9px; padding: 9px 14px; border-bottom: 1px solid var(--adm-line); }
+  .adm-nav[data-open=true] { display: grid; }
+  .adm-topbar { min-height: 49px; padding-block: 6px; }
+  .adm-main { padding: 16px 12px; }
+}
+@media (max-width: 480px) {
+  .adm-page { gap: 15px; }
+  .adm-profile > div { display: none; }
+  .adm-facilities { grid-template-columns: 1fr; }
+  .adm-facility + .adm-facility { border-left: 0; border-top: 1px solid var(--adm-line); }
+  .adm-stat-grid { gap: 8px; }
+  .adm-stat { padding: 11px; }
+  .adm-toolbar { padding: 10px 12px; }
+  .adm-form-grid { grid-template-columns: 1fr; }
+  .adm-subform { grid-template-columns: minmax(0, 1fr); }
+}
