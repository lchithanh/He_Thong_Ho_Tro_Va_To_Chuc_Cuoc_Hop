+export const TRANG_THAI_PHONG = {
+  SAN_SANG: ['Sẵn sàng', 'xanh'], BAO_TRI: ['Bảo trì', 'vang'],
+  NGUNG_SU_DUNG: ['Ngừng sử dụng', 'xam'], BAN: ['Bận', 'vam'],
+}
+export const TINH_TRANG_THIET_BI = {
+  TOT: ['Tốt', 'xanh'], HU_HONG: ['Hư hỏng', 'do'], BAO_TRI: ['Bảo trì', 'vang'],
+  NGUNG_SU_DUNG: ['Ngừng sử dụng', 'xam'],
+}
+export const TRANG_THAI_TAI_KHOAN = {
+  HOAT_DONG: ['Hoạt động', 'xanh'], NGUNG_HOAT_DONG: ['Ngừng hoạt động', 'xam'],
+  BI_KHOA: ['Bị khóa', 'do'], TAM_KHOA: ['Tạm khóa', 'vang'],
+}
+export const DINH_DANG_SO = new Intl.NumberFormat('vi-VN')
