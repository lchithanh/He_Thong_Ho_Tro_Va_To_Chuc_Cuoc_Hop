+import org.springframework.transaction.event.TransactionalEventListener;
+
+import lombok.RequiredArgsConstructor;
+import lombok.extern.slf4j.Slf4j;
+
+@Slf4j
+@Component
+@RequiredArgsConstructor
+public class CapNhatHoSoRealtime {
+
+    private final SimpMessagingTemplate kenhGui;
+
+    public record KeHoachThayDoi(Set<Integer> nguoiNhanIds) {}
+
+    @TransactionalEventListener(phase = TransactionPhase.AFTER_COMMIT)
+    public void guiTinHieu(KeHoachThayDoi suKien) {
+        for (Integer nguoiNhanId : suKien.nguoiNhanIds()) {
+            try {
+                kenhGui.convertAndSendToUser(nguoiNhanId.toString(), "/queue/cap-nhat", "KE_HOACH_CAP_NHAT");
+            } catch (MessagingException ex) {
+                log.warn("Không gửi được tín hiệu cập nhật kế hoạch cho tài khoản {}", nguoiNhanId, ex);
+            }
+        }
+    }
+}
